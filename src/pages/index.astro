---
import Layout from '../layouts/Layout.astro';
import WaterCalculator from '../components/WaterCalculator.jsx';
---

<Layout title="Farm Water Calculator">
	<main class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-green-50">
		<header class="bg-white/80 backdrop-blur-sm border-b border-gray-200/50 shadow-sm">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
				<div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 mb-4">
					<div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-green-500 rounded-xl flex items-center justify-center flex-shrink-0">
						<span class="text-white text-2xl">💧</span>
					</div>
					<div class="min-w-0 flex-1">
						<h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold bg-gradient-to-r from-blue-600 to-green-600 bg-clip-text text-transparent">
							Farm Water Calculator
						</h1>
						<p class="text-gray-600 mt-1 text-base sm:text-lg">
							Advanced irrigation planning for optimal crop yield
						</p>
					</div>
				</div>
				<div class="flex flex-wrap gap-4 sm:gap-6 text-sm text-gray-500">
					<span class="flex items-center gap-1">
						<span>🌱</span>
						<span class="hidden sm:inline">Precise water requirements</span>
						<span class="sm:hidden">Water calc</span>
					</span>
					<span class="flex items-center gap-1">
						<span>⚡</span>
						<span class="hidden sm:inline">Smart mixing ratios</span>
						<span class="sm:hidden">Mixing</span>
					</span>
					<span class="flex items-center gap-1">
						<span>📊</span>
						<span class="hidden sm:inline">Storage optimization</span>
						<span class="sm:hidden">Storage</span>
					</span>
				</div>
			</div>
		</header>

		<div class="max-w-7xl mx-auto mt-8 px-4 sm:px-6">
			<WaterCalculator client:load />
		</div>
	</main>
</Layout>